---
import { localePath, useTranslations } from '../i18n/utils';
import '../styles/global.css';

const en = useTranslations('en');
const zh = useTranslations('zh');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>404 — Runnan Pan</title>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600&family=Newsreader:opsz,wght@6..72,500;6..72,600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="min-h-screen bg-paper px-5 py-24 text-ink antialiased">
		<main class="mx-auto max-w-xl">
			<p class="text-sm text-accent-ink">404</p>
			<h1 class="mt-4 font-serif text-4xl tracking-tight">{en.notFound.title}</h1>
			<p class="mt-3 text-muted">{en.notFound.body}</p>
			<a class="mt-6 inline-block text-ink hover:text-accent" href={localePath('en')}>{en.notFound.home}</a>
			<hr class="my-10 border-line" />
			<h2 class="font-serif text-3xl tracking-tight">{zh.notFound.title}</h2>
			<p class="mt-3 text-muted">{zh.notFound.body}</p>
			<a class="mt-6 inline-block text-ink hover:text-accent" href={localePath('zh')}>{zh.notFound.home}</a>
		</main>
	</body>
</html>
