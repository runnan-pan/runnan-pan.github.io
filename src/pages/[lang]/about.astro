---
import { Image } from 'astro:assets';
import { images } from '../../assets/images/registry';
import PageIntro from '../../components/PageIntro.astro';
import { profile } from '../../data/site';
import type { Locale } from '../../i18n/config';
import { getLocaleStaticPaths, localize, useTranslations } from '../../i18n/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
	return getLocaleStaticPaths();
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} route="about">
	<PageIntro title={t.about.title} />
	<section class="mx-auto grid max-w-5xl gap-10 px-5 pb-8 pt-10 sm:px-8 lg:grid-cols-[220px_1fr]">
		<Image
			src={images.portraits.hero}
			alt={localize(profile.name, lang)}
			class="aspect-[4/5] w-full rounded-sm object-cover"
			widths={[220, 440, 800]}
			sizes="(min-width: 1024px) 220px, 100vw"
		/>
		<div class="max-w-2xl space-y-5 text-lg leading-relaxed text-ink/90">
			<p>{t.about.p1}</p>
			<p>{t.about.p2}</p>
			<p>{t.about.p3}</p>
			<div class="border-t border-line pt-6">
				<h2 class="font-serif text-2xl tracking-tight">{t.about.nowTitle}</h2>
				<p class="mt-3 text-muted">{t.about.nowBody}</p>
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-5xl px-5 pb-8 pt-4 sm:px-8">
		<div class="grid gap-10 sm:grid-cols-2">
			<div class="max-w-2xl border-t border-line pt-6">
				<h2 class="font-serif text-2xl tracking-tight">{t.about.educationTitle}</h2>
				<ul class="mt-4 space-y-5 text-ink/90">
					{
						t.about.education.map((item) => (
							<li>
								<p class="text-base font-medium">{item.degree}</p>
								<p class="mt-1 text-sm text-muted">{item.school}</p>
								<p class="mt-1 text-sm text-muted">{item.period}</p>
							</li>
						))
					}
				</ul>
			</div>
			<div class="max-w-2xl border-t border-line pt-6">
				<h2 class="font-serif text-2xl tracking-tight">{t.about.languagesTitle}</h2>
				<p class="mt-3 text-muted">{t.about.languages.join(' · ')}</p>

				<h2 class="mt-8 font-serif text-2xl tracking-tight">{t.about.interestsTitle}</h2>
				<p class="mt-3 text-muted">{t.about.interests}</p>
			</div>
		</div>
	</section>
</BaseLayout>
