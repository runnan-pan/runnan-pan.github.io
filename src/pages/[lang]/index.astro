---
import { Image } from 'astro:assets';
import { images } from '../../assets/images/registry';
import WorkCard from '../../components/WorkCard.astro';
import { profile } from '../../data/site';
import { work } from '../../data/work';
import type { Locale } from '../../i18n/config';
import { getLocaleStaticPaths, localePath, localize, useTranslations } from '../../i18n/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
	return getLocaleStaticPaths();
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const featured = work.slice(0, 2);
---

<BaseLayout lang={lang} route="home">
	<section class="mx-auto grid max-w-5xl items-center gap-12 px-5 pt-16 sm:px-8 sm:pt-24 lg:grid-cols-[1.2fr_0.8fr]">
		<div>
			<p class="text-sm tracking-wide text-accent-ink">{t.home.kicker}</p>
			<h1 class="mt-4 max-w-xl font-serif text-4xl leading-tight tracking-tight sm:text-6xl">
				{t.home.headline}
			</h1>
			<p class="mt-6 max-w-xl text-lg text-muted">{t.home.lede}</p>
			<div class="mt-8 flex flex-wrap gap-3">
				<a
					href={localePath(lang, 'about')}
					class="bg-ink px-4 py-2 text-sm text-paper hover:bg-accent"
				>
					{t.home.aboutCta}
				</a>
				<a
					href={localePath(lang, 'work')}
					class="border border-line px-4 py-2 text-sm text-ink hover:border-ink"
				>
					{t.home.workCta}
				</a>
			</div>
		</div>
		<Image
			src={images.portraits.hero}
			alt={localize(profile.name, lang)}
			class="aspect-[4/5] w-full rounded-sm object-cover"
			widths={[320, 640, 960]}
			sizes="(min-width: 1024px) 360px, 100vw"
			loading="eager"
			fetchpriority="high"
		/>
	</section>

	<section class="mx-auto max-w-5xl px-5 pt-20 sm:px-8">
		<div class="flex items-end justify-between gap-4">
			<h2 class="font-serif text-3xl tracking-tight">{t.home.featuredTitle}</h2>
			<a href={localePath(lang, 'work')} class="text-sm text-muted hover:text-accent">
				{t.home.featuredMore}
			</a>
		</div>
		<div class="mt-4">
			{featured.map((item) => <WorkCard item={item} lang={lang} />)}
		</div>
	</section>
</BaseLayout>
